<UserControl x:Class="HospitalManagement.Views.Management.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="4">
        <TabItem Header="Danh mục Thuốc">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Header="Thông tin thuốc">
                    <WrapPanel>
                        <StackPanel Width="200" Margin="4">
                            <TextBlock Text="Tên thuốc"/>
                            <TextBox Text="{Binding DrugName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="4">
                            <TextBlock Text="Đơn vị"/>
                            <TextBox Text="{Binding DrugUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="120" Margin="4">
                            <TextBlock Text="Đơn giá"/>
                            <TextBox Text="{Binding DrugPrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="4">
                            <TextBlock Text="Tồn kho"/>
                            <TextBox Text="{Binding DrugStock, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Lưu" Command="{Binding SaveDrugCommand}" VerticalAlignment="Bottom" Margin="4,0,2,2"/>
                        <Button Content="Mới" Style="{StaticResource SecondaryButton}" Command="{Binding NewDrugCommand}" VerticalAlignment="Bottom" Margin="2,0,2,2"/>
                        <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteDrugCommand}" VerticalAlignment="Bottom" Margin="2,0,2,2"/>
                    </WrapPanel>
                </GroupBox>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Drugs}" SelectedItem="{Binding SelectedDrug}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding DrugId}" Width="60"/>
                        <DataGridTextColumn Header="Tên thuốc" Binding="{Binding DrugName}" Width="*"/>
                        <DataGridTextColumn Header="Đơn vị" Binding="{Binding Unit}" Width="100"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="130"/>
                        <DataGridTextColumn Header="Tồn kho" Binding="{Binding StockQuantity}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Bảng giá Dịch vụ">
            <Grid Margin="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <GroupBox Header="Thông tin dịch vụ y tế">
                    <WrapPanel>
                        <StackPanel Width="240" Margin="4">
                            <TextBlock Text="Tên dịch vụ"/>
                            <TextBox Text="{Binding ServiceName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="140" Margin="4">
                            <TextBlock Text="Đơn giá"/>
                            <TextBox Text="{Binding ServicePrice, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="160" Margin="4">
                            <TextBlock Text="Danh mục"/>
                            <TextBox Text="{Binding ServiceCategory, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <Button Content="Lưu" Command="{Binding SaveServiceCommand}" VerticalAlignment="Bottom" Margin="4,0,2,2"/>
                        <Button Content="Mới" Style="{StaticResource SecondaryButton}" Command="{Binding NewServiceCommand}" VerticalAlignment="Bottom" Margin="2,0,2,2"/>
                        <Button Content="Xóa" Style="{StaticResource SecondaryButton}" Command="{Binding DeleteServiceCommand}" VerticalAlignment="Bottom" Margin="2,0,2,2"/>
                    </WrapPanel>
                </GroupBox>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding ServiceId}" Width="60"/>
                        <DataGridTextColumn Header="Tên dịch vụ" Binding="{Binding ServiceName}" Width="*"/>
                        <DataGridTextColumn Header="Danh mục" Binding="{Binding Category}" Width="160"/>
                        <DataGridTextColumn Header="Đơn giá" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>