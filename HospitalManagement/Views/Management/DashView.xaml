<UserControl x:Class="HospitalManagement.Views.Management.DashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="TỔNG QUAN &amp; THỐNG KÊ HOẠT ĐỘNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Cập nhật số liệu" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshDashboardCommand}"/>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,4">
            <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="1" Padding="12" Margin="4">
                <StackPanel>
                    <TextBlock Text="DOANH THU ĐÃ THU" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} VNĐ}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="1" Padding="12" Margin="4">
                <StackPanel>
                    <TextBlock Text="TỔNG BỆNH NHÂN" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="{Binding TotalPatients}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="1" Padding="12" Margin="4">
                <StackPanel>
                    <TextBlock Text="TỔNG LƯỢT KHÁM" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="{Binding TotalRecords}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="1" Padding="12" Margin="4">
                <StackPanel>
                    <TextBlock Text="TỔNG LỊCH HẸN" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                    <TextBlock Text="{Binding TotalAppointments}" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <GroupBox Grid.Row="2" Header="Gửi thông báo chỉ đạo / cấp cứu đến toàn viện">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Phát thông báo" Command="{Binding SendAlertCommand}"/>
                <TextBox Text="{Binding AlertText, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </GroupBox>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Doanh thu theo ngày">
                <DataGrid ItemsSource="{Binding RevenueByDates}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding DateLabel}" Width="140"/>
                        <DataGridTextColumn Header="Doanh thu (VNĐ)" Binding="{Binding Revenue, StringFormat={}{0:N0}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="Hiệu suất khám của Bác sĩ">
                <DataGrid ItemsSource="{Binding DoctorPerformances}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Bác sĩ" Binding="{Binding DoctorName}" Width="*"/>
                        <DataGridTextColumn Header="Số ca khám" Binding="{Binding ExamCount}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>