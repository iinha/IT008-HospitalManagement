<UserControl x:Class="HospitalManagement.Views.Admin.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="NHẬT KÝ HOẠT ĐỘNG HỆ THỐNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshLogsCommand}"/>
        </DockPanel>
        <DataGrid Grid.Row="1" ItemsSource="{Binding SysLogs}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Log ID" Binding="{Binding LogId}" Width="70"/>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding LoggedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160"/>
                <DataGridTextColumn Header="Người thực hiện" Binding="{Binding User.Fullname}" Width="180"/>
                <DataGridTextColumn Header="Hành động" Binding="{Binding Action}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>