<UserControl x:Class="HospitalManagement.Views.Admin.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="4">
        <TextBlock Text="SAO LƯU &amp; PHỤC HỒI CƠ SỞ DỮ LIỆU" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,12"/>
        <GroupBox Header="Đường dẫn tập tin sao lưu (.bak)">
            <StackPanel>
                <DockPanel Margin="0,4">
                    <Button DockPanel.Dock="Right" Content="Chọn đường dẫn..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseBackupCommand}"/>
                    <TextBox Text="{Binding BackupPath, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,4">
                    <Button Content="Thực hiện Sao lưu (Backup)" Command="{Binding BackupCommand}"/>
                    <Button Content="Phục hồi CSDL (Restore)" Style="{StaticResource SecondaryButton}" Command="{Binding RestoreCommand}" Margin="8,2"/>
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="0,8,0,0"/>
            </StackPanel>
        </GroupBox>
    </StackPanel>
</UserControl>