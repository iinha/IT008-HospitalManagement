<UserControl x:Class="HospitalManagement.Views.Admin.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:HospitalManagement.Helpers">
    <UserControl.Resources>
        <helpers:BoolToActiveTextConverter x:Key="ActiveConv"/>
        <helpers:RoleToVietnameseConverter x:Key="RoleViConv"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="QUẢN LÝ TÀI KHOẢN &amp; PHÂN QUYỀN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshAllCommand}"/>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Cấp tài khoản mới / Thao tác tài khoản đang chọn">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Width="160" Margin="4">
                        <TextBlock Text="Tên đăng nhập"/>
                        <TextBox Text="{Binding NewUsername, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="160" Margin="4">
                        <TextBlock Text="Mật khẩu"/>
                        <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="200" Margin="4">
                        <TextBlock Text="Họ và tên"/>
                        <TextBox Text="{Binding NewFullname, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Width="150" Margin="4">
                        <TextBlock Text="Vai trò"/>
                        <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding NewRole}"/>
                    </StackPanel>
                    <Button Content="Tạo tài khoản" Command="{Binding CreateAccountCommand}" VerticalAlignment="Bottom" Margin="4,0,4,2"/>
                </WrapPanel>

                <WrapPanel Margin="0,8,0,0">
                    <Button Content="Khóa / Mở khóa tài khoản chọn" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleLockCommand}" Margin="4"/>
                    <TextBox Width="180" Text="{Binding ResetPasswordText, UpdateSourceTrigger=PropertyChanged}" Margin="12,4,4,4"/>
                    <Button Content="Cấp lại mật khẩu" Command="{Binding ResetPasswordCommand}" Margin="4"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding UserId}" Width="60"/>
                <DataGridTextColumn Header="Tên đăng nhập" Binding="{Binding Username}" Width="160"/>
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding Fullname}" Width="*"/>
                <DataGridTextColumn Header="Vai trò" Binding="{Binding Role, Converter={StaticResource RoleViConv}}" Width="140"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive, Converter={StaticResource ActiveConv}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="4"/>
    </Grid>
</UserControl>