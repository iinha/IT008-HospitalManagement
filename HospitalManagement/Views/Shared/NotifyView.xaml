<UserControl x:Class="HospitalManagement.Views.Shared.NotifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderThickness="0,0,0,1" Padding="12,8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{StaticResource LightBlue}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBlue}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAlertUrgent}" Value="True">
                        <Setter Property="Background" Value="#FDECEA"/>
                        <Setter Property="BorderBrush" Value="#DC3545"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="THÔNG BÁO:" FontWeight="Bold" Margin="0,0,8,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource PrimaryBlue}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlertUrgent}" Value="True">
                                <Setter Property="Foreground" Value="#DC3545"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding NotificationMessage}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextDark}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlertUrgent}" Value="True">
                                <Setter Property="Foreground" Value="#DC3545"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </Border>
</UserControl>