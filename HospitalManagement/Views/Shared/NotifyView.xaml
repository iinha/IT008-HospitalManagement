<UserControl x:Class="HospitalManagement.Views.Shared.NotifyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="0,0,0,1" Padding="12,8">
        <DockPanel>
            <TextBlock DockPanel.Dock="Left" Text="THÔNG BÁO:" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,8,0"/>
            <TextBlock Text="{Binding NotificationMessage}" Foreground="{StaticResource TextDark}"/>
        </DockPanel>
    </Border>
</UserControl>