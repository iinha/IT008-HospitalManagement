<Window x:Class="HospitalManagement.Views.Shared.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:HospitalManagement.Helpers"
        xmlns:shared="clr-namespace:HospitalManagement.Views.Shared"
        Title="Hệ thống Quản lý Bệnh viện" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Width="230" Background="{StaticResource PrimaryBlue}"
                Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="14,16">
                    <TextBlock Text="BỆNH VIỆN MẮT" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentUserDisplay}" Foreground="#E3F2FD" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Đăng xuất" Command="{Binding LogoutCommand}"
                        Background="#003D82" BorderThickness="0" Padding="14,10" Margin="0"/>

                <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Title}"
                                    Style="{StaticResource NavButton}"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1" LastChildFill="True">
            <shared:NotifyView DockPanel.Dock="Top"
                               Visibility="{Binding ShowNotifyBar, Converter={StaticResource BoolToVis}}"/>
            <ContentControl Content="{Binding CurrentView}" Margin="10"/>
        </DockPanel>
    </Grid>
</Window>