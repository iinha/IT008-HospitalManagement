<UserControl x:Class="HospitalManagement.Views.Reception.CheckinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="TIẾP NHẬN BỆNH NHÂN, ĐỐI SOÁT BHYT &amp; ĐIỀU PHỐI PHÒNG" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
        </DockPanel>

        <GroupBox Grid.Row="1" Header="Thao tác Check-in lịch hẹn đang chọn">
            <WrapPanel>
                <StackPanel Width="180" Margin="4">
                    <TextBlock Text="Phân phòng khám"/>
                    <ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" DisplayMemberPath="RoomName"/>
                </StackPanel>
                <StackPanel Width="150" Margin="4">
                    <TextBlock Text="Phí khám ban đầu (VNĐ)"/>
                    <TextBox Text="{Binding ExamFee, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <Button Content="Xác nhận Check-in &amp; Đẩy hàng đợi" Command="{Binding CheckInCommand}" VerticalAlignment="Bottom" Margin="8,0,4,2"/>
            </WrapPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Appointments}" SelectedItem="{Binding SelectedAppointment}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã hẹn" Binding="{Binding ApptId}" Width="75"/>
                <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Patient.Fullname}" Width="*"/>
                <DataGridTextColumn Header="SĐT" Binding="{Binding Patient.Phone}" Width="115"/>
                <DataGridTextColumn Header="Mã BHYT" Binding="{Binding Patient.HealthInsuranceCode}" Width="135"/>
                <DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor.Fullname}" Width="160"/>
                <DataGridTextColumn Header="Ngày khám" Binding="{Binding ApptDate}" Width="105"/>
                <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeSlot}" Width="115"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="4"/>
    </Grid>
</UserControl>