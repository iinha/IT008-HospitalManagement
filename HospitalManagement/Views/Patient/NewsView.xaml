<UserControl x:Class="HospitalManagement.Views.Patient.NewsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="CỔNG THÔNG TIN &amp; TIN TỨC SỨC KHỎE" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <ComboBox DockPanel.Dock="Right" Width="200" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <DataGrid Grid.Column="0" ItemsSource="{Binding Articles}" SelectedItem="{Binding SelectedArticle}" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tiêu đề" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="Chuyên mục" Binding="{Binding Category}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Column="1" Header="Nội dung bài viết">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedArticle.Title}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedArticle.CreatedAt, StringFormat=Đăng ngày: dd/MM/yyyy}" Foreground="#666666" Margin="0,4,0,10"/>
                        <TextBlock Text="{Binding SelectedArticle.Content}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>