<UserControl x:Class="HospitalManagement.Views.Patient.QnAView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="GÓC HỎI ĐÁP CÙNG BÁC SĨ" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="4,0,4,8"/>

        <GroupBox Grid.Row="1" Header="Đặt câu hỏi mới">
            <StackPanel>
                <TextBlock Text="Chọn bác sĩ (tùy chọn):"/>
                <ComboBox ItemsSource="{Binding QuestionDoctors}" SelectedItem="{Binding QuestionDoctor}" DisplayMemberPath="Fullname" Width="280" HorizontalAlignment="Left"/>
                <TextBlock Text="Nội dung thắc mắc:" Margin="0,6,0,0"/>
                <TextBox Text="{Binding QuestionContent, UpdateSourceTrigger=PropertyChanged}" Height="65" AcceptsReturn="True" TextWrapping="Wrap"/>
                <Button Content="Gửi câu hỏi" Command="{Binding SendQuestionCommand}" HorizontalAlignment="Left" Margin="2,6"/>
                <TextBlock Text="{Binding QnaStatusMessage}" Foreground="{StaticResource PrimaryBlue}" TextWrapping="Wrap"/>
            </StackPanel>
        </GroupBox>

        <DataGrid Grid.Row="2" ItemsSource="{Binding MyQuestions}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ngày gửi" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Câu hỏi" Binding="{Binding Content}" Width="*"/>
                <DataGridTextColumn Header="Phản hồi từ Bác sĩ" Binding="{Binding AnswerContent}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>