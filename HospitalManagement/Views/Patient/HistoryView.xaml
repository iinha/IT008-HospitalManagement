<UserControl x:Class="HospitalManagement.Views.Patient.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="4">
        <TabItem Header="Lịch hẹn đã đặt">
            <DataGrid ItemsSource="{Binding MyAppointments}" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã hẹn" Binding="{Binding ApptId}" Width="80"/>
                    <DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor.Fullname}" Width="*"/>
                    <DataGridTextColumn Header="Ngày khám" Binding="{Binding ApptDate}" Width="120"/>
                    <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeSlot}" Width="140"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="Lịch sử khám &amp; Đơn kính">
            <DataGrid ItemsSource="{Binding MedicalHistory}" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HS" Binding="{Binding RecordId}" Width="70"/>
                    <DataGridTextColumn Header="Ngày khám" Binding="{Binding VisitDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                    <DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor.Fullname}" Width="150"/>
                    <DataGridTextColumn Header="Chẩn đoán" Binding="{Binding Diagnosis}" Width="*"/>
                    <DataGridTextColumn Header="Thị lực MP/MT" Binding="{Binding Exammetric.VisionRight}" Width="100"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>

        <TabItem Header="Biên lai thanh toán">
            <DataGrid ItemsSource="{Binding MyBills}" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã HĐ" Binding="{Binding BillId}" Width="75"/>
                    <DataGridTextColumn Header="Loại chi phí" Binding="{Binding BillType}" Width="*"/>
                    <DataGridTextColumn Header="Số tiền (VNĐ)" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="140"/>
                    <DataGridTextColumn Header="Ngày lập" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </TabItem>
    </TabControl>
</UserControl>