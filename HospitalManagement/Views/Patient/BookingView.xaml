<UserControl x:Class="HospitalManagement.Views.Patient.BookingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Đặt lịch khám bệnh">
            <StackPanel>
                <TextBlock Text="Chọn Bác sĩ:"/>
                <ComboBox ItemsSource="{Binding Doctors}" SelectedItem="{Binding SelectedDoctor}" DisplayMemberPath="Fullname"/>
                <TextBlock Text="Ngày khám:" Margin="0,8,0,0"/>
                <DatePicker SelectedDate="{Binding BookingDate}"/>
                <TextBlock Text="Khung giờ trống:" Margin="0,8,0,0"/>
                <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedTimeSlot}"/>
                <Button Content="Xác nhận Đặt lịch" Command="{Binding BookCommand}" Margin="2,14,2,6"/>
                <Border Background="{StaticResource LightBlue}" BorderBrush="{StaticResource BorderBlue}" BorderThickness="1" Padding="10" Margin="2,8">
                    <StackPanel>
                        <TextBlock Text="MÃ ĐẶT HẸN CỦA BẠN:" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlue}"/>
                        <TextBlock Text="{Binding BookingCode}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding BookingStatusMessage}" Foreground="{StaticResource PrimaryBlue}" TextWrapping="Wrap" Margin="2,6"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Hồ sơ cá nhân &amp; Thông tin BHYT">
            <StackPanel>
                <TextBlock Text="Họ và tên:"/>
                <TextBox Text="{Binding Profile.Fullname, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Số điện thoại:"/>
                <TextBox Text="{Binding Profile.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Ngày sinh:"/>
                <DatePicker SelectedDate="{Binding Profile.DateofBirth}"/>
                <TextBlock Text="Giới tính:"/>
                <TextBox Text="{Binding Profile.Gender, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="Mã thẻ Bảo hiểm y tế (BHYT):"/>
                <TextBox Text="{Binding Profile.HealthInsuranceCode, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Lưu cập nhật hồ sơ" Style="{StaticResource SecondaryButton}" Command="{Binding SaveProfileCommand}" Margin="2,12,2,2"/>
                <TextBlock Text="{Binding ProfileStatusMessage}" Foreground="{StaticResource PrimaryBlue}" TextWrapping="Wrap" Margin="2,6"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>