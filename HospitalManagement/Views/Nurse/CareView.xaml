<UserControl x:Class="HospitalManagement.Views.Nurse.CareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="THỰC HIỆN Y LỆNH CHĂM SÓC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding CareOrders}" SelectedItem="{Binding SelectedCareOrder}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CareOrderId}" Width="60"/>
                <DataGridTextColumn Header="Hồ sơ" Binding="{Binding RecordId}" Width="70"/>
                <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Record.Patient.Fullname}" Width="180"/>
                <DataGridTextColumn Header="Thao tác y lệnh" Binding="{Binding ActionName}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130"/>
                <DataGridTextColumn Header="Thời gian" Binding="{Binding ExecuteAt, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4">
            <Button Content="Đánh dấu Hoàn thành y lệnh" Command="{Binding CompleteCareOrderCommand}"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>