<UserControl x:Class="HospitalManagement.Views.Nurse.MeasureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Hồ sơ chờ đo chỉ số ban đầu">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="Làm mới danh sách" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                <DataGrid ItemsSource="{Binding WaitingRecords}" SelectedItem="{Binding SelectedRecord}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HS" Binding="{Binding RecordId}" Width="60"/>
                        <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Patient.Fullname}" Width="*"/>
                        <DataGridTextColumn Header="Bác sĩ" Binding="{Binding Doctor.Fullname}" Width="140"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Nhập chỉ số Thị lực / Nhãn áp / Khúc xạ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="4">
                            <TextBlock Text="Thị lực Phải"/>
                            <TextBox Text="{Binding VisionRight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Nhãn áp Phải"/>
                            <TextBox Text="{Binding IopRight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="SPH Phải"/>
                            <TextBox Text="{Binding SphRight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="CYL Phải"/>
                            <TextBox Text="{Binding CylRight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="AXIS Phải"/>
                            <TextBox Text="{Binding AxisRight, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="4">
                            <TextBlock Text="Thị lực Trái"/>
                            <TextBox Text="{Binding VisionLeft, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Nhãn áp Trái"/>
                            <TextBox Text="{Binding IopLeft, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="SPH Trái"/>
                            <TextBox Text="{Binding SphLeft, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="CYL Trái"/>
                            <TextBox Text="{Binding CylLeft, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="AXIS Trái"/>
                            <TextBox Text="{Binding AxisLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>
                    <Button Content="Lưu chỉ số đo" Command="{Binding SaveMetricsCommand}" Margin="4,10"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="4"/>
                </StackPanel>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>