<UserControl x:Class="HospitalManagement.Views.Nurse.GuideView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="4,0,4,8">
            <TextBlock Text="DANH SÁCH CHỈ ĐỊNH CẬN LÂM SÀNG (HƯỚNG DẪN BỆNH NHÂN)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Làm mới" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"/>
        </DockPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding ServiceOrders}" SelectedItem="{Binding SelectedServiceOrder}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="HS" Binding="{Binding RecordId}" Width="60"/>
                <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Record.Patient.Fullname}" Width="180"/>
                <DataGridTextColumn Header="Dịch vụ chỉ định" Binding="{Binding Service.ServiceName}" Width="200"/>
                <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentStatus}" Width="130"/>
                <DataGridTextColumn Header="Ghi chú / Kết quả" Binding="{Binding ResultNote}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="Cập nhật ghi chú kết quả cận lâm sàng (KTV)">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Lưu kết quả" Command="{Binding SaveServiceResultCommand}"/>
                <TextBox Text="{Binding ResultNote, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>