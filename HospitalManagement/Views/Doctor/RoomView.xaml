<UserControl x:Class="HospitalManagement.Views.Doctor.RoomView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Header="Trạng thái Phòng khám">
            <DockPanel>
                <Button DockPanel.Dock="Bottom" Content="Đổi trạng thái (Trống / Đang dùng)" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleRoomStatusCommand}" Margin="0,6,0,0"/>
                <DataGrid ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding RoomId}" Width="60"/>
                        <DataGridTextColumn Header="Tên phòng" Binding="{Binding RoomName}" Width="*"/>
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Column="1" Header="Đăng ký &amp; Xem lịch trực">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DatePicker SelectedDate="{Binding ShiftDate}" Width="130"/>
                    <ComboBox ItemsSource="{Binding TimeFrames}" SelectedItem="{Binding ShiftTimeFrame}" Width="170"/>
                    <Button Content="Đăng ký trực phòng chọn" Command="{Binding RegisterShiftCommand}"/>
                </WrapPanel>
                <DataGrid ItemsSource="{Binding MyShifts}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ngày" Binding="{Binding ShiftDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                        <DataGridTextColumn Header="Phòng" Binding="{Binding Room.RoomName}" Width="*"/>
                        <DataGridTextColumn Header="Khung giờ" Binding="{Binding TimeFrame}" Width="160"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>