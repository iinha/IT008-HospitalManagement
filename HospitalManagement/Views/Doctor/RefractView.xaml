<UserControl x:Class="HospitalManagement.Views.Doctor.RefractView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="KHÁM KHÚC XẠ &amp; KÝ ĐƠN KÍNH" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,8"/>

            <GroupBox Header="Chọn hồ sơ bệnh nhân">
                <ComboBox ItemsSource="{Binding QueueRecords}" SelectedItem="{Binding SelectedRecord}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="HS #"/><Run Text="{Binding RecordId}"/>
                                <Run Text=" - "/><Run Text="{Binding Patient.Fullname}"/>
                                <Run Text=" ("/><Run Text="{Binding Status}"/><Run Text=")"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Mắt Phải (OD)">
                    <StackPanel>
                        <TextBlock Text="Thị lực (Vision Right)"/>
                        <TextBox Text="{Binding VisionRight, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Nhãn áp (IOP Right)"/>
                        <TextBox Text="{Binding IopRight, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Độ Cầu (SPH Right)"/>
                        <TextBox Text="{Binding SphRight, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Độ Trụ (CYL Right)"/>
                        <TextBox Text="{Binding CylRight, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Trục (AXIS Right)"/>
                        <TextBox Text="{Binding AxisRight, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Mắt Trái (OS)">
                    <StackPanel>
                        <TextBlock Text="Thị lực (Vision Left)"/>
                        <TextBox Text="{Binding VisionLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Nhãn áp (IOP Left)"/>
                        <TextBox Text="{Binding IopLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Độ Cầu (SPH Left)"/>
                        <TextBox Text="{Binding SphLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Độ Trụ (CYL Left)"/>
                        <TextBox Text="{Binding CylLeft, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Trục (AXIS Left)"/>
                        <TextBox Text="{Binding AxisLeft, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="4,8">
                <Button Content="Xác nhận &amp; Ký đơn kính" Command="{Binding SignRefractionCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>