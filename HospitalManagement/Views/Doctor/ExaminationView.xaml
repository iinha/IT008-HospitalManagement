<UserControl x:Class="HospitalManagement.Views.Doctor.ExaminationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4">
            <TextBlock Text="KHÁM LÂM SÀNG, CHỈ ĐỊNH &amp; KÊ ĐƠN THUỐC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0,0,0,8"/>

            <GroupBox Header="Bệnh nhân đang khám">
                <ComboBox ItemsSource="{Binding QueueRecords}" SelectedItem="{Binding SelectedRecord}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="HS #"/><Run Text="{Binding RecordId}"/>
                                <Run Text=" - "/><Run Text="{Binding Patient.Fullname}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>

            <GroupBox Header="Chẩn đoán lâm sàng">
                <StackPanel>
                    <TextBlock Text="Triệu chứng:"/>
                    <TextBox Text="{Binding Symptoms, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <TextBlock Text="Chẩn đoán &amp; Kết luận:"/>
                    <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" Height="50" AcceptsReturn="True" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock Text="Hướng xử lý:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding OutcomeOptions}" SelectedItem="{Binding ExamOutcome}"/>
                        <CheckBox Content="Chuyển nội trú / Nhập viện mổ" IsChecked="{Binding IsInpatient}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Grid.Column="0" Header="Chỉ định Cận lâm sàng &amp; Y lệnh">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Chỉ định" Command="{Binding OrderServiceCommand}"/>
                            <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding SelectedService}" DisplayMemberPath="ServiceName"/>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding CurrentRecordServices}" Height="120" Margin="0,6">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service.ServiceName}" Width="*"/>
                                <DataGridTextColumn Header="TT Phí" Binding="{Binding PaymentStatus}" Width="105"/>
                                <DataGridTextColumn Header="Kết quả" Binding="{Binding ResultNote}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Tạo y lệnh y tá" Style="{StaticResource SecondaryButton}" Command="{Binding AddCareOrderCommand}"/>
                            <TextBox Text="{Binding CareActionName, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Column="1" Header="Kê đơn thuốc điện tử">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Drugs}" SelectedItem="{Binding SelectedDrug}" DisplayMemberPath="DrugName"/>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DrugQty, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="1" Text="{Binding DrugDosage, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="Thêm thuốc" Command="{Binding AddDrugCommand}"/>
                        </Grid>
                        <DataGrid ItemsSource="{Binding CurrentRecordPrescriptions}" Height="120" Margin="0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tên thuốc" Binding="{Binding Drug.DrugName}" Width="*"/>
                                <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="50"/>
                                <DataGridTextColumn Header="Liều dùng" Binding="{Binding Dosage}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="4,8">
                <Button Content="Lưu &amp; Hoàn tất ca khám" Command="{Binding FinishExamCommand}" Padding="16,8"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}" Margin="4"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>