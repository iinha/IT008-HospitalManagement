<UserControl x:Class="HospitalManagement.Views.Doctor.QnAView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="TRẢ LỜI CÂU HỎI TỪ BỆNH NHÂN" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="4,0,4,8"/>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Questions}" SelectedItem="{Binding SelectedQuestion}" Margin="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding QuestionId}" Width="60"/>
                <DataGridTextColumn Header="Bệnh nhân" Binding="{Binding Patient.Fullname}" Width="160"/>
                <DataGridTextColumn Header="Câu hỏi" Binding="{Binding Content}" Width="*"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="2" Header="Nội dung trả lời">
            <StackPanel>
                <TextBox Text="{Binding AnswerText, UpdateSourceTrigger=PropertyChanged}" Height="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                <Button Content="Gửi câu trả lời" Command="{Binding ReplyQuestionCommand}" HorizontalAlignment="Left" Margin="2,6,2,2"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PrimaryBlue}"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>